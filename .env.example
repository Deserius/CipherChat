# CipherRoom environment configuration
# Copy this file to .env and fill in values. NEVER commit real credentials.

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public URL of the application (used for invite links and CORS)
APP_URL=http://localhost:3000
# Comma-separated extra allowed origins (preview hosts, staging, etc.)
# CORS_ORIGINS=https://example.com
# Allow embedding in an iframe (needed for some preview environments).
# In production, leave unset or false so clickjacking protections apply.
ALLOW_FRAMING=false

# -----------------------------------------------------------------------------
# Room lifecycle
# -----------------------------------------------------------------------------
# Default length of randomly generated room codes (4–10)
ROOM_CODE_LENGTH=6
# Maximum participants per room
ROOM_MAX_PARTICIPANTS=12
# Milliseconds to wait after a disconnect before removing a participant
PARTICIPANT_GRACE_MS=15000
# Milliseconds to wait after the last participant leaves before destroying the room
ROOM_DESTROY_GRACE_MS=30000
# Hard maximum lifetime of a room regardless of activity (0 = disabled)
ROOM_MAX_LIFETIME_MS=14400000
# Inactivity timeout: destroy if no messages/media activity (0 = disabled)
ROOM_INACTIVITY_MS=3600000

# -----------------------------------------------------------------------------
# Limits / abuse prevention
# -----------------------------------------------------------------------------
MAX_MESSAGE_CHARS=4000
MAX_FILE_BYTES=8388608
MAX_WS_PAYLOAD_BYTES=10485760
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_HTTP=120
RATE_LIMIT_MAX_JOIN=20
RATE_LIMIT_MAX_CREATE=10
WS_MAX_CONNECTIONS_PER_IP=20
MESSAGE_RATE_MAX=30
MESSAGE_RATE_WINDOW_MS=10000

# -----------------------------------------------------------------------------
# WebRTC / ICE
# -----------------------------------------------------------------------------
# Comma-separated STUN URLs. These servers will observe client IP addresses.
# Default uses Cloudflare + Google public STUN if unset.
STUN_SERVER=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
# Optional TURN (recommended in production). Example: turn:turn.example.com:3478
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=
# Optional TURNS (TLS)
# TURNS_SERVER=turns:turn.example.com:5349

# -----------------------------------------------------------------------------
# Optional Redis/Valkey (multi-instance). If unset, in-memory state is used.
# Rooms remain ephemeral either way. TTL is applied to all keys.
# -----------------------------------------------------------------------------
REDIS_URL=

# -----------------------------------------------------------------------------
# Optional Twilio (PSTN / SMS). Web messaging/video work without these.
# NEVER put these values in frontend code.
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# Trust proxy (set true behind Render / Nginx / Cloudflare)
# -----------------------------------------------------------------------------
TRUST_PROXY=false
